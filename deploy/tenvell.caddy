tenvell.space {
    root * /srv/tenvell/current
    encode zstd gzip

    # Server-side measurement only. Never log IPs, cookies, auth or arbitrary
    # request headers/query parameters. This log belongs to this host alone.
    log tenvell {
        output file /var/log/caddy/tenvell-access.json {
            mode 0640
            roll_size 5MiB
            roll_keep 31
            roll_keep_for 744h
        }
        format filter {
            wrap json
            fields {
                request>remote_ip delete
                request>client_ip delete
                request>remote_port delete
                request>headers delete
                request>tls delete
                request>uri regexp `\?.*$` ""
                resp_headers delete
                user_id delete
                # Only a DNS hostname: discard userinfo, ports, paths, queries,
                # literal IPs and malformed/non-HTTP referrers before writing.
                referrer_host regexp `^(?:https?://(?:[^/?#]*@)?([A-Za-z0-9.-]*[A-Za-z][A-Za-z0-9.-]*)(?::[0-9]+)?(?:[/?#].*)?|.*)$` "$1"
            }
        }
    }
    log_append <path {http.request.uri.path}
    log_append user_agent {http.request.header.User-Agent}
    log_append referrer_host {http.request.header.Referer}
    log_append utm_source {http.request.uri.query.utm_source}
    log_append utm_medium {http.request.uri.query.utm_medium}
    log_append utm_campaign {http.request.uri.query.utm_campaign}
    log_append utm_content {http.request.uri.query.utm_content}

    header X-Content-Type-Options "nosniff"

    @writes not method GET HEAD
    respond @writes 404

    # Ownership proofs survive website deployments. Keep their unpredictable
    # filenames out of source control and out of request analytics.
    @indexNowProof path_regexp indexnow ^/[a-f0-9]{32}\.txt$
    log_skip @indexNowProof
    handle @indexNowProof {
        root * /srv/tenvell/search-verification
        header X-Robots-Tag "noindex, nofollow"
        file_server
    }

    @immutable path /assets/* /releases/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    @registry path /r /r/*
    header @registry {
        Access-Control-Allow-Origin "*"
        Cache-Control "no-cache"
    }

    @agentDocs path /llms.txt /llms-full.txt /AGENTS.md /index.md /install.md /agents.md /docs/* /skills/*
    header @agentDocs {
        Access-Control-Allow-Origin "*"
        Cache-Control "public, max-age=0, must-revalidate"
        Link "</llms.txt>; rel=\"describedby\""
    }
    @markdown path_regexp markdown \.md$
    header @markdown Content-Type "text/markdown; charset=utf-8"

    @agentFiles path /llms.txt /llms-full.txt /AGENTS.md /index.md /install.md /agents.md /docs /docs/* /skills /skills/* /robots.txt /sitemap.xml
    handle @agentFiles {
        file_server
    }

    @files path /r /r/* /releases /releases/* /assets /assets/* /fonts /fonts/* /api /api/*
    handle @files {
        file_server
    }

    @guidePaths path /ru/* /react-glassmorphism-ui-kit/* /react-dashboard-ui-kit/* /shadcn-glass-components/* /choosing-a-react-ui-kit/*
    handle @guidePaths {
        try_files {path} {path}.html =404
        header Cache-Control "no-cache"
        file_server
    }

    @pages path / /install /agents /agents.html /react-glassmorphism-ui-kit /react-dashboard-ui-kit /shadcn-glass-components /choosing-a-react-ui-kit /sample /examples/tasks /examples/messenger /examples/dashboard /typeface /typeface.html
    handle @pages {
        try_files {path} {path}.html /index.html
        header Cache-Control "no-cache"
        file_server
    }

    @html header Accept *text/html*
    handle @html {
        try_files {path} {path}.html /index.html
        header Cache-Control "no-cache"
        file_server
    }

    handle {
        try_files {path} {path}.html =404
        file_server
    }
}

www.tenvell.space {
    redir https://tenvell.space{uri} permanent
}
